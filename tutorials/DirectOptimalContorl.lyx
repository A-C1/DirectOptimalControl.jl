\begin_body

\begin_layout Standard
An 
\begin_inset Formula $p$
\end_inset

-phase optimal control problem can be stated in the following general form.
 Determine the state, 
\begin_inset Formula ${\bf x^{(p)}}(t)\in\mathbb{R}^{n_{z}^{(p)}}$
\end_inset

 control 
\begin_inset Formula ${\bf u^{(p)}}(t)\in\mathbb{R}^{n_{u}^{(p)}}$
\end_inset

, initial time 
\begin_inset Formula $t_{i}^{(p)}\in\mathbb{R}$
\end_inset

, final time 
\begin_inset Formula $t_{f}^{(p)}\in\mathbb{R}$
\end_inset

, integrals, 
\begin_inset Formula ${\bf q}^{(p)}\in\mathbb{R}^{n_{q}^{(p)}}$
\end_inset

, local parameters 
\begin_inset Formula ${\bf k_{p}}\in\mathbb{R}^{n_{k}^{(p)}}$
\end_inset

 in each phase 
\begin_inset Formula $p\in[1,...,P]$
\end_inset

, and the static parameters, 
\begin_inset Formula ${\bf k_{g}}\in\mathbb{R}^{n_{kg}}$
\end_inset

, that minimize the cost functional 
\begin_inset Formula 
\[
J=\sum_{p=1}^{n}J_{p}
\]

\end_inset

where,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
J_{p}=\intop_{t_{i}^{p}}^{t_{f}^{p}}L^{p}({\bf x^{(p)}}(t),{\bf u^{(p)}}(t),t^{(p)},{\bf k},{\bf ap})\ dt^{(p)}+\phi(x^{(p)}(t_{f}^{p}),u^{(p)}(t_{f}^{p}),t_{f}^{(p)},{\bf k},{\bf ap})
\]

\end_inset


\end_layout

\begin_layout Standard
Note: 
\begin_inset Formula ${\bf ap}$
\end_inset

 contains all the auxillary parameters used to define various functions,
 and 
\begin_inset Formula ${\bf k}=[{\bf k_{p}};{\bf k_{g}}]$
\end_inset

 is a stacked vector of phase and global parameters which can be optimized.
 
\end_layout

\begin_layout Standard
The cost funtional 
\begin_inset Formula $J$
\end_inset

 must be minimized subject to the following constraints in each phase 
\begin_inset Formula $p$
\end_inset

:
\end_layout

\begin_layout Enumerate

\series bold
Path constraints
\series default
: Path constraints are the constraints which the states and controls must
 obey at each instant 
\begin_inset Formula $t^{(p)}$
\end_inset

 .
\begin_inset Formula 
\[
{\bf pf_{l}}^{(p)}\leq{\bf pathfun}^{(p)}({\bf x^{p}}(t),{\bf u^{p}}(t),t^{(p)},{\bf k},{\bf ap})\in\mathbb{R}^{n_{pf}^{k}}\leq{\bf pf_{u}}^{(p)}\ \forall\ t^{(p)}\in[t_{i}^{(p)},t_{f}^{(p)}]
\]

\end_inset


\end_layout

\begin_layout Enumerate

\series bold
Integral constraints
\series default
: Define 
\begin_inset Formula 
\[
{\bf IF}^{(p)}=\intop_{t_{i}^{p}}^{t_{f}^{p}}{\bf integralfun}^{(p)}({\bf x^{(p)}}(t),{\bf u^{(p)}}(t),t^{(p)},{\bf k},{\bf ap})\ dt^{(p)}
\]

\end_inset


\begin_inset Formula 
\[
{\bf if_{l}}^{(p)}\leq{\bf pathfun}({\bf x^{p}}(t),{\bf u^{p}}(t),t^{(p)},{\bf k},{\bf ap})\in\mathbb{R}^{n_{pf}^{k}}\leq{\bf if_{u}}^{(p)}
\]

\end_inset


\end_layout

\begin_layout Enumerate

\series bold
Event constraints
\series default
: Events in time are what cause a change of phase.
 Event constraints represent linkages between initial times, states, inputs
 and final times, states, inputs between phases.
\begin_inset Formula 
\[
{\bf psi_{u}}^{(p)}\leq{\bf psi}(t_{i}^{(1)},t_{f}^{(1)},{\bf x_{f}}^{(1)},{\bf u_{f}}^{(1)},t_{i}^{(2)},t_{f}^{(2)},{\bf x_{f}}^{(2)},{\bf u_{f}}^{(2)},\ldots t_{i}^{(P)},t_{f}^{(P)},{\bf x_{f}}^{(P)},{\bf u_{f}}^{(P)})\in\mathbb{R}^{n_{psi}^{(p)}}\leq{\bf psi_{u}}^{(p)}
\]

\end_inset


\end_layout

